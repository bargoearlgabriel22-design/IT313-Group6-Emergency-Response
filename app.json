{
  "expo": {
    "name": "Community Emergency Response Assistant",
    "slug": "community-emergency-response-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "emergency-response",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Community Emergency Response Assistant to access your camera to capture photo evidence.",
          "microphonePermission": false,
          "photosPermission": "Allow Community Emergency Response Assistant to access your photo library."
        }
      ]
    ]
  }
}
